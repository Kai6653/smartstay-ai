# --- Option A: local Ollama (free, no key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# --- Option B: Ollama cloud API (needs a key from ollama.com) ---
# OLLAMA_HOST=https://ollama.com
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_API_KEY=paste-your-key-here

# Set to "none" to disable the AI model completely (facts-only replies)
LLM_PROVIDER=ollama
STAFF_TOKEN=change-me
